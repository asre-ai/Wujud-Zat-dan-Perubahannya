rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Validator Blueprint untuk Hasil Kuis (Append-Only, Anti-Ghost-Field)
    function isValidQuizResult(data) {
      return data.keys().hasAll(['nama', 'waktu', 'skor', 'jumlahBenar', 'jumlahSalah']) &&
             data.keys().hasOnly(['nama', 'waktu', 'skor', 'jumlahBenar', 'jumlahSalah', 'createdAt', 'isTeacher']) &&
             data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 60 &&
             data.waktu is string && data.waktu.size() <= 60 &&
             data.skor is number && data.skor >= 0 && data.skor <= 100 &&
             data.jumlahBenar is number && data.jumlahBenar >= 0 && data.jumlahBenar <= 10 &&
             data.jumlahSalah is number && data.jumlahSalah >= 0 && data.jumlahSalah <= 10 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
             (!('isTeacher' in data) || data.isTeacher is bool);
    }

    // 3. Validator Blueprint untuk Sesi Masuk Siswa
    function isValidStudentSession(data) {
      return data.keys().hasAll(['nama', 'waktu', 'skor']) &&
             data.keys().hasOnly(['nama', 'waktu', 'skor', 'createdAt']) &&
             data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 60 &&
             data.waktu is string && data.waktu.size() <= 60 &&
             data.skor is number && data.skor >= 0 && data.skor <= 100 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    // 4. Koleksi Hasil Kuis Siswa: Terbuka untuk dibaca seluruh kelas & guru, buat baru hanya dengan skema valid, izinkan hapus saat reset kelas
    match /quiz_results/{resultId} {
      allow read: if true;
      allow create: if isValidId(resultId) && isValidQuizResult(incoming());
      allow delete: if true;
      allow update: if false;
    }

    // 5. Koleksi Sesi Siswa: Terbuka untuk dibaca, buat baru hanya dengan skema valid, izinkan hapus saat reset kelas
    match /student_sessions/{sessionId} {
      allow read: if true;
      allow create: if isValidId(sessionId) && isValidStudentSession(incoming());
      allow delete: if true;
      allow update: if false;
    }

    // 6. Validasi koneksi awal (Probe)
    match /test/{testId} {
      allow read: if true;
    }
  }
}
